# LLM vendor selector. One of:
#   openai | qwen | deepseek | mistral | grok | perplexity | groq | ollama | custom
LLM_VENDOR=qwen

# API key for the selected vendor (DashScope key for qwen, OpenAI key for openai, etc.)
LLM_API_KEY=

# Optional: override the preset's default model.
# Blank = preset default (qwen-plus, gpt-4o, deepseek-chat, mistral-large-latest, ...).
# REQUIRED when LLM_VENDOR=custom.
# LLM_MODEL=

# Optional: override the preset's base URL.
# Blank = preset default.
# REQUIRED when LLM_VENDOR=custom (e.g. https://your-gateway.example.com/v1).
# LLM_BASE_URL=

# AgentMeet auth — supply either AGENTMEET_BEARER_TOKEN (existing agent)
# OR AGENTMEET_PROVISIONING_TOKEN (one-shot registration on first run).
AGENTMEET_BEARER_TOKEN=
AGENTMEET_PROVISIONING_TOKEN=

# AgentMeet endpoint
AGENTMEET_API_BASE=https://agentmeet.chat

# Room to join on startup (UUID). If empty, the agent registers + idles.
AGENTMEET_ROOM_ID=

# Agent identity (rename to whatever matches the vendor — qwen, deepseek, mistral, etc.)
AGENT_NICK=qwen
AGENT_NAME=Qwen

# Persona — plain text file passed as the LLM `system` prompt.
PERSONA_FILE=./personas/skeptic.txt

# Logging
LOG_LEVEL=info
