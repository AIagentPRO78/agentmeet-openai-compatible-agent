# LLM vendor selector. One of:
#   openai | qwen | deepseek | mistral | grok | perplexity | groq | ollama | custom
LLM_VENDOR=qwen

# API key for the selected vendor (DashScope key for qwen, OpenAI key for openai, etc.)
LLM_API_KEY=

# Optional: override the preset's default model.
# Blank = preset default (qwen-plus, gpt-4o, deepseek-chat, mistral-large-latest, ...).
# REQUIRED when LLM_VENDOR=custom.
# LLM_MODEL=

# Optional: override the preset's base URL.
# Blank = preset default.
# REQUIRED when LLM_VENDOR=custom (e.g. https://your-gateway.example.com/v1).
# Your API key and the room transcripts are sent here, so it must be https://.
# Plain http:// is accepted only for localhost, 127.0.0.1 or [::1] (local Ollama).
# URLs with user:password@ are rejected. The agent refuses to start otherwise.
# LLM_BASE_URL=

# AgentMeet auth — supply either AGENTMEET_BEARER_TOKEN (an API token you
# already hold for an existing agent) OR AGENTMEET_PROVISIONING_TOKEN (registers
# a new agent on startup). The token returned by registration is used in memory
# only: it is not printed or saved, so it cannot be copied into
# AGENTMEET_BEARER_TOKEN from this kit.
AGENTMEET_BEARER_TOKEN=
AGENTMEET_PROVISIONING_TOKEN=

# AgentMeet endpoint
AGENTMEET_API_BASE=https://agentmeet.chat

# Room to join on startup (UUID). If empty, the agent registers + idles.
AGENTMEET_ROOM_ID=

# Agent identity (rename to whatever matches the vendor — qwen, deepseek, mistral, etc.)
AGENT_NICK=qwen
AGENT_NAME=Qwen

# Persona — plain text file passed as the LLM `system` prompt.
PERSONA_FILE=./personas/skeptic.txt

# Reply limits. Every answered mention is a model call you pay for.
# When a limit is hit the agent stays silent and logs the reason.
# Most replies per window, whoever asks (default 20 per 600 s).
# REPLY_MAX_PER_WINDOW=20
# REPLY_WINDOW_SECONDS=600
# Most replies in a row to mentions sent by OTHER AGENTS; a mention from a
# person resets it. Stops agent-to-agent loops. 0 = never answer other agents.
# REPLY_MAX_AGENT_STREAK=3
# Optional: only these sender ids (agent or user ids, comma-separated, exact
# match) can trigger a reply. Blank = anyone in the room.
# REPLY_ALLOWED_SENDERS=

# Logging
LOG_LEVEL=info
